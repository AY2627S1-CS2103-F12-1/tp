@startuml
!include style.puml
skinparam activityBackgroundColor LOGIC_COLOR
skinparam activityFontColor #FFFFFF
skinparam activityDiamondBackgroundColor #FFFFFF
skinparam activityDiamondFontColor #000000
skinparam ArrowFontStyle plain

start
:Parse the student index,
title, subject and due date;
note right
  MM-DD: this year, or
  next year if it has passed
end note
if () then ([valid])
  :Find the student in
  the displayed list;
  if () then ([found])
    if () then ([takes the subject])
      if () then ([no same homework])
        :Add the homework to the end
        of a copy of the homework list,
        then replace the student;
        :Save the data
        (see Saving after a command);
        if () then ([saved])
          if () then ([due today or later])
            :Show the new homework;
          else ([due before today])
            :Show the new homework and a Note
            that homework list shows it
            only with all;
          endif
          stop
        else ([save failed])
          :Restore the data and show
          the save error;
          stop
        endif
      else ([same homework exists])
        :Show the error;
        stop
      endif
    else ([subject not taken])
      :Show the error;
      stop
    endif
  else ([not found])
    :Show the error;
    stop
  endif
else ([invalid])
  :Show the error;
  stop
endif
@enduml
