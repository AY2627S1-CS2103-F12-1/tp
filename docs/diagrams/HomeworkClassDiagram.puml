@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
hide members

Package Model as ModelPackage {
Class Student
Class Homework
Class Title
Enum "<<enumeration>>\nTuitionSubject" as TuitionSubject
Class DueDate
Class Score
Enum "<<enumeration>>\nHomeworkStatus" as HomeworkStatus
}

Student *--> "0..*\n{ordered}" Homework : homeworks
Homework --> "1" Title : title
Homework --> "1" TuitionSubject : subject
Homework --> "1" DueDate : dueDate
Homework --> "0..1" Score : score
Homework --> "1" HomeworkStatus : status

note right of Student
  HOMEWORK_INDEX is the one-based
  position in this list (insertion order).
end note
@enduml
