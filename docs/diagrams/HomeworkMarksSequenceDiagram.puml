@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":HomeworkCommandParser" as HomeworkCommandParser LOGIC_COLOR
participant ":HomeworkMarksCommandParser" as HomeworkMarksCommandParser LOGIC_COLOR
participant "c:HomeworkMarksCommand" as HomeworkMarksCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "<<class>>\nScore" as Score MODEL_COLOR
participant "scored:Homework" as Homework MODEL_COLOR
participant "m:Model" as Model MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

[-> LogicManager : execute("hw m 1 2 score/5/10")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("hw m 1 2 score/5/10")
activate AddressBookParser

create HomeworkCommandParser
AddressBookParser -> HomeworkCommandParser
activate HomeworkCommandParser

HomeworkCommandParser --> AddressBookParser
deactivate HomeworkCommandParser

AddressBookParser -> HomeworkCommandParser : parse("m 1 2 score/5/10")
activate HomeworkCommandParser

create HomeworkMarksCommandParser
HomeworkCommandParser -> HomeworkMarksCommandParser
activate HomeworkMarksCommandParser

HomeworkMarksCommandParser --> HomeworkCommandParser
deactivate HomeworkMarksCommandParser

HomeworkCommandParser -> HomeworkMarksCommandParser : parse("1 2 score/5/10")
activate HomeworkMarksCommandParser

HomeworkMarksCommandParser -> Score : parse("5/10")
activate Score

Score --> HomeworkMarksCommandParser : score
deactivate Score

create HomeworkMarksCommand
HomeworkMarksCommandParser -> HomeworkMarksCommand
activate HomeworkMarksCommand

HomeworkMarksCommand --> HomeworkMarksCommandParser
deactivate HomeworkMarksCommand

HomeworkMarksCommandParser --> HomeworkCommandParser : c
deactivate HomeworkMarksCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
HomeworkMarksCommandParser -[hidden]-> HomeworkCommandParser
destroy HomeworkMarksCommandParser

HomeworkCommandParser --> AddressBookParser : c
deactivate HomeworkCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
HomeworkCommandParser -[hidden]-> AddressBookParser
destroy HomeworkCommandParser

AddressBookParser --> LogicManager : c
deactivate AddressBookParser

LogicManager -> HomeworkMarksCommand : execute(m)
activate HomeworkMarksCommand

HomeworkMarksCommand -> Model : getStudentList()
activate Model

Model --> HomeworkMarksCommand : students
deactivate Model

create Homework
HomeworkMarksCommand -> Homework : Homework(title, subject, dueDate, score)
activate Homework

Homework --> HomeworkMarksCommand
deactivate Homework

HomeworkMarksCommand -> Model : setStudent(s, s.withHomeworks(updated))
activate Model

Model --> HomeworkMarksCommand
deactivate Model

create CommandResult
HomeworkMarksCommand -> CommandResult
activate CommandResult

CommandResult --> HomeworkMarksCommand
deactivate CommandResult

HomeworkMarksCommand --> LogicManager : r
deactivate HomeworkMarksCommand

opt data changed
LogicManager -> Storage : saveAddressBook(m.getAddressBook())
activate Storage

Storage --> LogicManager
deactivate Storage
end

[<--LogicManager
deactivate LogicManager
@enduml
