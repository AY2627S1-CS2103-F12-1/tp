@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "u:HomeworkUpcomingCommand" as HomeworkUpcomingCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "a:ReadOnlyAddressBook" as AddressBook MODEL_COLOR
end box

[-> LogicManager : execute("hw up due/3")
activate LogicManager

ref over LogicManager, HomeworkUpcomingCommand
  parse "hw up due/3" into u
  (today's date, 3 days)
end ref

LogicManager -> HomeworkUpcomingCommand : execute(m)
activate HomeworkUpcomingCommand

HomeworkUpcomingCommand -> Model : getAddressBook()
activate Model

Model --> HomeworkUpcomingCommand : a
deactivate Model

HomeworkUpcomingCommand -> AddressBook : getStudentList()
activate AddressBook

AddressBook --> HomeworkUpcomingCommand : students
deactivate AddressBook

loop for each student in students
  HomeworkUpcomingCommand -> HomeworkUpcomingCommand : keep homework due\nfrom today to today + 3
end

HomeworkUpcomingCommand -> HomeworkUpcomingCommand : sort the kept homework\nby due date

HomeworkUpcomingCommand -> Model : updateFilteredStudentList(PREDICATE_SHOW_ALL_STUDENTS)
activate Model

Model --> HomeworkUpcomingCommand
deactivate Model

HomeworkUpcomingCommand --> LogicManager : result
deactivate HomeworkUpcomingCommand

note right of LogicManager
  The data is unchanged,
  so it is not saved.
end note

[<-- LogicManager : result
deactivate LogicManager
@enduml
