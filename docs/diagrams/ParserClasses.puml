@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

Class "{abstract}\nCommand" as Command
Class XYZCommand
Class AddCommand

package "Parser classes"{
Class "<<interface>>\nParser" as Parser
Class AddressBookParser
Class XYZCommandParser
Class AddCommandParser
Class StudentAddParser
Class ParserUtil
Class StrictArgumentTokenizer
Class TokenizedArguments
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> AddressBookParser

AddressBookParser .down.> XYZCommandParser: <<create>>

XYZCommandParser ..> XYZCommand : <<create>>
AddressBookParser ..> Command : <<use>>
XYZCommandParser .up.|> Parser
XYZCommandParser ..> StrictArgumentTokenizer
XYZCommandParser ..> TokenizedArguments
StrictArgumentTokenizer .left.> TokenizedArguments : <<create>>
XYZCommandParser ..> ParserUtil
XYZCommand -up-|> Command

AddressBookParser ..> AddCommandParser : <<create>>
AddCommandParser .up.|> Parser
AddCommandParser --> "1" StudentAddParser
StudentAddParser ..> StrictArgumentTokenizer
AddCommandParser ..> AddCommand : <<create>>
AddCommand -up-|> Command

@enduml
