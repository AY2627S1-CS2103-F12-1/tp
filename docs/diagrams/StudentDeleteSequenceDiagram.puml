@startuml
!include style.puml
skinparam ArrowFontStyle plain

box UI UI_COLOR_T1
participant ":MainWindow" as MainWindow UI_COLOR
end box

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":DeleteCommandParser" as DeleteCommandParser LOGIC_COLOR
participant "<<class>>\nParserUtil" as ParserUtil LOGIC_COLOR
participant "d:DeleteCommand" as DeleteCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant ":ModelManager" as ModelManager MODEL_COLOR
participant ":AddressBook" as AddressBook MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

MainWindow -> LogicManager : execute("delete 1")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("delete 1")
activate AddressBookParser

create DeleteCommandParser
AddressBookParser -> DeleteCommandParser
AddressBookParser -> DeleteCommandParser : parse(" 1")
activate DeleteCommandParser

DeleteCommandParser -> ParserUtil : parseStrictIndex(" 1", message)
activate ParserUtil
ParserUtil --> DeleteCommandParser : index
deactivate ParserUtil

create DeleteCommand
DeleteCommandParser -> DeleteCommand
DeleteCommandParser --> AddressBookParser : d
deactivate DeleteCommandParser
AddressBookParser --> LogicManager : d
deactivate AddressBookParser
destroy DeleteCommandParser

LogicManager -> ModelManager : getAddressBook()
activate ModelManager
ModelManager --> LogicManager : current roster
deactivate ModelManager
note right of LogicManager
  Copy current roster as dataBeforeCommand.
  Predicate and display-order snapshots are omitted.
end note

LogicManager -> DeleteCommand : execute(model)
activate DeleteCommand
DeleteCommand -> ModelManager : getStudentList()
activate ModelManager
ModelManager --> DeleteCommand : displayed students
deactivate ModelManager

DeleteCommand -> ModelManager : deleteStudent(selected student)
activate ModelManager
ModelManager -> AddressBook : deleteStudent(selected student)
activate AddressBook
AddressBook --> ModelManager
deactivate AddressBook
ModelManager --> DeleteCommand
deactivate ModelManager

DeleteCommand --> LogicManager : CommandResult
deactivate DeleteCommand

LogicManager -> ModelManager : getAddressBook()
activate ModelManager
ModelManager --> LogicManager : updated roster
deactivate ModelManager
note right of LogicManager
  Compare updated roster with dataBeforeCommand.
  The command remains available for save-failure feedback.
end note

alt roster changed
  LogicManager -> Storage : saveAddressBook(updated roster)
  activate Storage
  Storage --> LogicManager
  deactivate Storage
else roster unchanged
  note right of LogicManager
    Skip the data-file write.
  end note
end

LogicManager --> MainWindow : CommandResult
deactivate LogicManager

note over ModelManager, AddressBook
  Deleting from the roster also updates
  the displayed student list.
  Valid displayed index and successful save are assumed.
  Save-failure rollback is shown in the saving activity.
end note
@enduml
