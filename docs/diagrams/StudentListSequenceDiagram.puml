@startuml
!include style.puml
skinparam ArrowFontStyle plain

box UI UI_COLOR_T1
participant ":MainWindow" as MainWindow UI_COLOR
end box

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":ListCommandParser" as ListCommandParser LOGIC_COLOR
participant "l:ListCommand" as ListCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant ":ModelManager" as ModelManager MODEL_COLOR
participant "students:FilteredList<Student>" as FilteredStudents MODEL_COLOR
end box

MainWindow -> LogicManager : execute("list")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("list")
activate AddressBookParser

create ListCommandParser
AddressBookParser -> ListCommandParser
AddressBookParser -> ListCommandParser : parse("")
activate ListCommandParser

create ListCommand
ListCommandParser -> ListCommand
ListCommandParser --> AddressBookParser : l
deactivate ListCommandParser
AddressBookParser --> LogicManager : l
deactivate AddressBookParser

LogicManager -> ListCommand : execute(model)
activate ListCommand
ListCommand -> ModelManager : updateFilteredStudentList(showAll)
activate ModelManager
ModelManager -> FilteredStudents : setPredicate(showAll)
ModelManager --> ListCommand
deactivate ModelManager

ListCommand -> ModelManager : getStudentList()
activate ModelManager
ModelManager --> ListCommand : all students
deactivate ModelManager

ListCommand --> LogicManager : CommandResult
deactivate ListCommand

note over LogicManager
  The stored AddressBook is unchanged,
  so LogicManager does not save it.
end note

LogicManager --> MainWindow : CommandResult
deactivate LogicManager

note over ModelManager, FilteredStudents
  The student list panel observes the filtered list
  and refreshes to show all students.
end note
@enduml
