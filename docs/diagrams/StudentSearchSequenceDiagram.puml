@startuml
!include style.puml
skinparam ArrowFontStyle plain

box UI UI_COLOR_T1
participant ":MainWindow" as MainWindow UI_COLOR
end box

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":SearchCommandParser" as SearchCommandParser LOGIC_COLOR
participant "s:SearchCommand" as SearchCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant ":ModelManager" as ModelManager MODEL_COLOR
participant "studentListPredicate:ReadOnlyObjectWrapper" as PredicateState MODEL_COLOR
participant "displayed:StudentDisplayList" as DisplayedStudents MODEL_COLOR
end box

MainWindow -> LogicManager : execute("search Jane")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("search Jane")
activate AddressBookParser

create SearchCommandParser
AddressBookParser -> SearchCommandParser
AddressBookParser -> SearchCommandParser : parse(" Jane")
activate SearchCommandParser

create SearchCommand
SearchCommandParser -> SearchCommand
SearchCommandParser --> AddressBookParser : s
deactivate SearchCommandParser
AddressBookParser --> LogicManager : s
deactivate AddressBookParser

LogicManager -> SearchCommand : execute(model)
activate SearchCommand
SearchCommand -> ModelManager : updateFilteredStudentList(predicate)
activate ModelManager
ModelManager -> PredicateState : set(predicate)
activate PredicateState
note right of PredicateState
  The bound FilteredList updates its predicate.
  A search predicate clears the active-filter description.
  Binding and list-observer callbacks are omitted.
end note
PredicateState --> ModelManager
deactivate PredicateState
ModelManager -> DisplayedStudents : resetOrder()
ModelManager --> SearchCommand
deactivate ModelManager

SearchCommand -> ModelManager : getStudentList()
activate ModelManager
ModelManager --> SearchCommand : matches in roster order
deactivate ModelManager

SearchCommand --> LogicManager : CommandResult
deactivate SearchCommand

note over LogicManager
  The stored AddressBook is unchanged,
  so LogicManager does not save it.
end note

LogicManager --> MainWindow : CommandResult
deactivate LogicManager

note over ModelManager, DisplayedStudents
  The panel observes an unmodifiable view of StudentDisplayList.
  Its roster order discards any previous sort.
  MainWindow calls showFromTop() after execution.
end note
@enduml
