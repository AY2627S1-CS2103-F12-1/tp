<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root minWidth="320" minHeight="240" title="Help" type="javafx.stage.Stage" xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1">
  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>
  <scene>
    <Scene width="640" height="420">
      <stylesheets>
        <URL value="@HelpWindow.css" />
      </stylesheets>

      <ScrollPane fx:id="helpScrollPane" fitToWidth="true" focusTraversable="true" hbarPolicy="NEVER"
          styleClass="help-scroll-pane">
        <VBox fx:id="helpContentBox" spacing="4" styleClass="help-content">
          <padding>
            <Insets top="10" right="16" bottom="16" left="16" />
          </padding>
        </VBox>
      </ScrollPane>
    </Scene>
  </scene>
</fx:root>
