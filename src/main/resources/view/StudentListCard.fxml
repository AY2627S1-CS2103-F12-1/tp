<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox id="cardPane" spacing="5" styleClass="student-card" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <padding><Insets top="10" right="12" bottom="10" left="12" /></padding>
  <HBox alignment="CENTER_LEFT" spacing="8">
    <Label fx:id="index" styleClass="student-card-name" />
    <Label fx:id="name" styleClass="student-card-name" />
    <Region HBox.hgrow="ALWAYS" />
    <Label fx:id="academicLevel" styleClass="student-card-badge" />
    <Label fx:id="subjects" styleClass="student-card-badge" />
  </HBox>
  <HBox alignment="CENTER_LEFT" spacing="16">
    <Label fx:id="studentPhone" styleClass="student-card-detail" />
    <Label fx:id="guardianName" styleClass="student-card-detail" />
    <Label fx:id="guardianPhone" styleClass="student-card-detail" />
  </HBox>
</VBox>
