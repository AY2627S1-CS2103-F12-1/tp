<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="7" styleClass="upcoming-panel" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <padding><Insets top="10" right="10" bottom="10" left="10" /></padding>
  <Label text="At a glance" styleClass="upcoming-title" />
  <HBox alignment="CENTER_LEFT" spacing="6">
    <Label text="Weekly lessons" styleClass="upcoming-section-title" />
    <Region HBox.hgrow="ALWAYS" />
    <Label fx:id="lessonCount" styleClass="upcoming-count" />
  </HBox>
  <ListView fx:id="lessonListView" minHeight="48" prefHeight="100" VBox.vgrow="ALWAYS" />
  <HBox alignment="CENTER_LEFT" spacing="6">
    <Label text="Outstanding homework" styleClass="upcoming-section-title" />
    <Region HBox.hgrow="ALWAYS" />
    <Label fx:id="homeworkCount" styleClass="upcoming-count" />
  </HBox>
  <ListView fx:id="homeworkListView" minHeight="48" prefHeight="100" VBox.vgrow="ALWAYS" />
</VBox>
